<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_title_1">
        <ListPreference
            android:key="resolution"
            android:title="@string/pref_title_2"
            android:summary="@string/pref_summary_3"
            android:defaultValue="800x480"
            android:entries="@array/resolution_labels"
            android:entryValues="@array/resolution_values" />
        <ListPreference
            android:key="fps"
            android:title="@string/pref_title_4"
            android:defaultValue="30"
            android:entries="@array/fps_labels"
            android:entryValues="@array/fps_values" />
        <ListPreference
            android:key="video_decoder"
            android:title="@string/pref_title_5"
            android:summary="@string/pref_summary_6"
            android:defaultValue="auto"
            android:entries="@array/video_decoder_labels"
            android:entryValues="@array/video_decoder_values" />
        <CheckBoxPreference
            android:key="adaptive_video"
            android:title="@string/pref_title_7"
            android:summary="@string/pref_summary_8"
            android:defaultValue="true" />
        <ListPreference
            android:key="night_source"
            android:title="@string/pref_title_9"
            android:summary="@string/pref_summary_10"
            android:defaultValue="honda"
            android:entries="@array/night_source_labels"
            android:entryValues="@array/night_source_values" />
        <ListPreference
            android:key="dpi"
            android:title="@string/pref_title_11"
            android:summary="@string/pref_summary_12"
            android:defaultValue="160"
            android:entries="@array/dpi_labels"
            android:entryValues="@array/dpi_values" />
        <CheckBoxPreference
            android:key="multi_touch"
            android:title="@string/pref_title_13"
            android:summary="@string/pref_summary_14"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_15">
        <CheckBoxPreference
            android:key="media_keys"
            android:title="@string/pref_title_16"
            android:summary="@string/pref_summary_17"
            android:defaultValue="true" />
        <ListPreference
            android:key="honda_sw_address"
            android:dependency="media_keys"
            android:title="@string/pref_title_18"
            android:summary="@string/pref_summary_19"
            android:defaultValue="260"
            android:entries="@array/honda_sw_address_labels"
            android:entryValues="@array/honda_sw_address_values" />
        <CheckBoxPreference
            android:key="calls_car_bt"
            android:title="@string/pref_title_20"
            android:summary="@string/pref_summary_21"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="return_after_camera"
            android:title="@string/pref_title_22"
            android:summary="@string/pref_summary_23"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="return_after_call"
            android:title="@string/pref_title_24"
            android:summary="@string/pref_summary_25"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="audio_usb"
            android:title="@string/pref_title_26"
            android:summary="@string/pref_summary_27"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="car_mic"
            android:title="@string/pref_title_28"
            android:summary="@string/pref_summary_29"
            android:defaultValue="true" />
        <Preference
            android:title="@string/pref_title_30"
            android:summary="@string/pref_summary_31">
            <intent
                android:targetPackage="com.fk2droid"
                android:targetClass="com.fk2droid.MicTestActivity" />
        </Preference>
        <ListPreference
            android:key="mic_source"
            android:title="@string/pref_title_32"
            android:summary="@string/pref_summary_33"
            android:defaultValue="auto"
            android:entries="@array/mic_source_labels"
            android:entryValues="@array/mic_source_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_34">
        <ListPreference
            android:key="display_thread"
            android:title="@string/pref_title_35"
            android:summary="@string/pref_summary_36"
            android:defaultValue="auto"
            android:entries="@array/display_thread_labels"
            android:entryValues="@array/display_thread_values" />
        <ListPreference
            android:key="video_format"
            android:title="@string/pref_title_37"
            android:summary="@string/pref_summary_38"
            android:defaultValue="0"
            android:entries="@array/video_format_labels"
            android:entryValues="@array/video_format_values" />
        <CheckBoxPreference
            android:key="show_keycodes"
            android:title="@string/pref_title_39"
            android:summary="@string/pref_summary_40"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="volume_invert"
            android:title="@string/pref_title_41"
            android:summary="@string/pref_summary_42"
            android:defaultValue="false" />
        <ListPreference
            android:key="sw_reg_mode"
            android:title="@string/pref_title_43"
            android:summary="@string/pref_summary_44"
            android:defaultValue="C"
            android:entries="@array/sw_reg_mode_labels"
            android:entryValues="@array/sw_reg_mode_values" />
        <ListPreference
            android:key="volume_window"
            android:title="@string/pref_title_45"
            android:summary="@string/pref_summary_46"
            android:defaultValue="3"
            android:entries="@array/volume_window_labels"
            android:entryValues="@array/volume_window_values" />
        <CheckBoxPreference
            android:key="track_invert"
            android:title="@string/pref_title_47"
            android:summary="@string/pref_summary_48"
            android:defaultValue="false" />
        <ListPreference
            android:key="volume_mode"
            android:title="@string/pref_title_49"
            android:summary="@string/pref_summary_50"
            android:defaultValue="honda"
            android:entries="@array/volume_mode_labels"
            android:entryValues="@array/volume_mode_values" />
        <Preference
            android:key="phone_status"
            android:title="@string/pref_title_51"
            android:summary="@string/pref_summary_52" />
        <Preference
            android:key="keyframe_status"
            android:title="@string/pref_title_53"
            android:summary="@string/pref_summary_54" />
        <CheckBoxPreference
            android:key="restart_on_black"
            android:title="@string/pref_title_55"
            android:summary="@string/pref_summary_56"
            android:defaultValue="true" />
        <Preference
            android:key="honda_state"
            android:title="@string/pref_title_57"
            android:summary="@string/pref_summary_58" />
        <Preference
            android:key="video_decoder_status"
            android:title="@string/pref_title_59"
            android:summary="@string/pref_summary_60" />
        <Preference
            android:key="honda_sw_status"
            android:title="@string/pref_title_61"
            android:summary="@string/pref_summary_62" />
        <Preference
            android:key="key_log"
            android:title="@string/pref_title_63"
            android:summary="@string/pref_summary_64" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_65">
        <EditTextPreference
            android:key="box_name"
            android:title="@string/pref_title_66"
            android:summary="@string/pref_summary_67"
            android:defaultValue="FK2Droid" />
        <CheckBoxPreference
            android:key="wifi_5g"
            android:title="@string/pref_title_68"
            android:summary="@string/pref_summary_69"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="right_hand_drive"
            android:title="@string/pref_title_70"
            android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
